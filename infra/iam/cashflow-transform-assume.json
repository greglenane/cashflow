{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDirectTransformRoleAssumption",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::377045608575:role/CashflowTransform"
    },
    {
      "Sid": "DenyTransformRoleAssumptionThroughMcp",
      "Effect": "Deny",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::377045608575:role/CashflowTransform",
      "Condition": {
        "Bool": {
          "aws:ViaAWSMCPService": "true"
        }
      }
    }
  ]
}
